{
  "name": "anzuk-marketing-hub",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,cms -c blue,green \"npm run dev -w @anzuk/web\" \"npm run dev -w @anzuk/cms\"",
    "dev:web": "npm run dev -w @anzuk/web",
    "dev:cms": "npm run dev -w @anzuk/cms",
    "build": "npm run build -w @anzuk/web",
    "build:web": "npm run build -w @anzuk/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
