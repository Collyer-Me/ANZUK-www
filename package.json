{
  "name": "anzuk-marketing-hub",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,cms -c blue,green \"npm run dev -w @anzuk/web\" \"npm run dev --prefix apps/cms\"",
    "dev:web": "npm run dev -w @anzuk/web",
    "dev:cms": "npm run dev --prefix apps/cms",
    "build": "npm run build -w @anzuk/web",
    "build:web": "npm run build -w @anzuk/web",
    "seed:strapi": "tsx scripts/seed-strapi.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4"
  }
}
