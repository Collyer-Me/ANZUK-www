# Public site URL (must match deployed GitHub Pages URL in production)
SITE_URL=http://localhost:4321

# GitHub project-site base path, e.g. /repo-name/ (leave unset for org site or local dev)
# BASE_PATH=/repo-name/

# Strapi Cloud API
STRAPI_URL=https://your-project.strapiapp.com
STRAPI_API_TOKEN=your-read-only-api-token

# Full access token for npm run seed:strapi only (never commit; do not use in GitHub Actions)
STRAPI_API_CURSOR=your-full-access-api-token

# Set to "true" to use bundled mock data when Strapi is unreachable (local dev only)
USE_MOCK_DATA=true

# Ketch consent (preferred: configure in Strapi Global Settings)
PUBLIC_KETCH_ORG=anzuk
PUBLIC_KETCH_PROPERTY=website_smart_tag

# RudderStack event pipeline (preferred: configure in Strapi Global Settings)
PUBLIC_RUDDERSTACK_WRITE_KEY=
PUBLIC_RUDDERSTACK_DATA_PLANE_URL=

# Optional GTM — marketing widgets only, NOT primary tracking
PUBLIC_GTM_ID=

# Strapi CMS only — webhook to trigger GitHub Actions deploy on publish
DEPLOY_WEBHOOK_URL=
DEPLOY_WEBHOOK_SECRET=

# Strapi CMS only — editor email to allowed regions (e.g. uk@anzuk.com:uk)
EDITOR_REGION_MAP=
