# Public site URL — use https://localhost:4321 in local dev (required for Storyblok Visual Editor)
SITE_URL=https://localhost:4321

# GitHub project-site base path, e.g. /repo-name/ (leave unset for org site or local dev)
# BASE_PATH=/repo-name/

# Storyblok Content Delivery API (preview token for local dev + Visual Editor)
STORYBLOK_DELIVERY_API_TOKEN=
# Space region: eu | us | ca | ap | cn (must match your Storyblok space)
STORYBLOK_REGION=eu

# Storyblok Management API (seed script only — never commit; rotate if exposed)
STORYBLOK_MANAGEMENT_TOKEN=
STORYBLOK_SPACE_ID=293225020771322

# Ketch consent
PUBLIC_KETCH_ORG=anzuk
PUBLIC_KETCH_PROPERTY=website_smart_tag

# RudderStack event pipeline
PUBLIC_RUDDERSTACK_WRITE_KEY=
PUBLIC_RUDDERSTACK_DATA_PLANE_URL=

# Lead form POST endpoint (Formspree, Azure Function, etc.) — not on Storyblok pilot pages
PUBLIC_FORM_ENDPOINT=

# Optional GTM — marketing widgets only, NOT primary tracking
PUBLIC_GTM_ID=

# Storyblok publish webhook → GitHub Actions (after proxy is deployed)
DISPATCH_PROXY_URL=
DISPATCH_WEBHOOK_SECRET=
GITHUB_PAGES_PREVIEW_URL=https://collyer-me.github.io/ANZUK-www/
