---
import '../styles/global.css';
import InternationalHeader from '../components/layout/InternationalHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import InternationalHead from '../components/seo/InternationalHead.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { getSiteUrl, siteConfig } from '../config/site';
import type { LocalizedPage, SiteSettings } from '../lib/strapi/types';

interface Props {
  page: LocalizedPage;
  settings: SiteSettings;
}

const { page, settings } = Astro.props;
const siteUrl = getSiteUrl();
---

<!doctype html>
<html lang="en">
  <head>
    <InternationalHead page={page} />
    <JsonLd
      schema={{
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Organization',
            '@id': `${siteUrl}/${siteConfig.organizationId}`,
            name: settings.siteName,
            url: settings.organizationUrl ?? siteUrl,
            ...(settings.contactEmail && { email: settings.contactEmail }),
          },
          {
            '@type': 'WebSite',
            '@id': `${siteUrl}/${siteConfig.websiteId}`,
            url: siteUrl,
            name: settings.siteName,
            publisher: { '@id': `${siteUrl}/${siteConfig.organizationId}` },
          },
        ],
      }}
    />
  </head>
  <body>
    <InternationalHeader {settings} />
    <main>
      <slot />
    </main>
    <SiteFooter settings={settings} />
  </body>
</html>
