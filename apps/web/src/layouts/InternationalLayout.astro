---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/motion.css';
import InternationalHeader from '../components/layout/InternationalHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import InternationalHead from '../components/seo/InternationalHead.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import KetchConsent from '../components/seo/KetchConsent.astro';
import RudderStackHead from '../components/seo/RudderStackHead.astro';
import { getSiteUrl, siteConfig } from '../config/site';
import { getRegionByCode } from '../lib/strapi/queries/regions';
import type { CmsPage, GlobalSettings } from '../lib/strapi/types';

interface Props {
  page: CmsPage;
  settings: GlobalSettings;
}

const { page, settings } = Astro.props;
const international = await getRegionByCode('international');
const siteUrl = getSiteUrl();
---

<!doctype html>
<html lang="en">
  <head>
    <InternationalHead page={page} />
    <KetchConsent settings={settings} cookiePolicyUrl={international?.cookiePolicyUrl} />
    <RudderStackHead
      settings={settings}
      regionCode="international"
      locale="en"
      pageType={page.pageType}
      pagePath={Astro.url.pathname}
    />
    <ClientRouter />
    <JsonLd
      schema={{
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Organization',
            '@id': `${siteUrl}/${siteConfig.organizationId}`,
            name: settings.organizationName,
            url: settings.organizationUrl ?? siteUrl,
            ...(international?.contactEmail && { email: international.contactEmail }),
          },
          {
            '@type': 'WebSite',
            '@id': `${siteUrl}/${siteConfig.websiteId}`,
            url: siteUrl,
            name: settings.organizationName,
            publisher: { '@id': `${siteUrl}/${siteConfig.organizationId}` },
          },
        ],
      }}
    />
  </head>
  <body>
    <script is:inline data-astro-rerun>document.documentElement.classList.add('js');</script>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[60] focus:rounded-anzuk-button focus:bg-anzuk-blue focus:px-4 focus:py-2 focus:font-semibold focus:text-white"
    >
      Skip to content
    </a>

    <InternationalHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter settings={settings} />

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
