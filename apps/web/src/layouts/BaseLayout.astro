---
import '../styles/global.css';
import { assetWithBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'ANZUK Education',
  description = 'International expertise in education. Local understanding.',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={assetWithBase('/favicon.svg')} type="image/svg+xml" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
