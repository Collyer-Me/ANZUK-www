---
interface Props {
  label: string;
  sample: string;
  meta: string;
  class?: string;
}

const { label, sample, meta, class: className = '' } = Astro.props;
---

<article class="rounded-anzuk-card border border-anzuk-light-gray bg-white p-6">
  <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-anzuk-icon-muted">{label}</p>
  <p class:list={['text-anzuk-title', className]}>{sample}</p>
  <p class="mt-3 font-mono text-xs text-anzuk-icon-muted">{meta}</p>
</article>
