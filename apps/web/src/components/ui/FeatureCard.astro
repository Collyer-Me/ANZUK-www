---
import type { ImageMetadata } from 'astro';
import Card from './Card.astro';

interface Props {
  title: string;
  description?: string | null;
  icon?: ImageMetadata;
  iconEmoji?: string;
  class?: string;
}

const { title, description, icon, iconEmoji, class: className = '' } = Astro.props;
---

<Card variant="outlined" class:list={['bg-anzuk-page-bg p-8', className]}>
  {
    icon ? (
      <img src={icon.src} alt="" class="h-14 w-14 object-contain" width={icon.width} height={icon.height} aria-hidden="true" />
    ) : iconEmoji ? (
      <span class="text-3xl" aria-hidden="true">{iconEmoji}</span>
    ) : null
  }
  <h3 class="mt-4 !text-2xl">{title}</h3>
  {description && <p class="mt-3 text-anzuk-content">{description}</p>}
</Card>
