---
import type { ImageMetadata } from 'astro';
import Card from './Card.astro';

interface Props {
  title: string;
  image: ImageMetadata;
  imageAlt: string;
  description?: string;
  href?: string;
  class?: string;
}

const { title, image, imageAlt, description, href, class: className = '' } = Astro.props;
---

<Card variant="elevated" href={href} class:list={['max-w-xs', className]}>
  <img
    src={image.src}
    alt={imageAlt}
    class="h-40 w-full object-cover"
    width={image.width}
    height={image.height}
    loading="lazy"
  />
  <div class="p-4">
    <h3 class="!mt-0 !text-lg font-semibold">{title}</h3>
    {description && <p class="text-sm text-anzuk-content">{description}</p>}
  </div>
</Card>
