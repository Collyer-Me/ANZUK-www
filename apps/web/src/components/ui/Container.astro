---
interface Props {
  class?: string;
  narrow?: boolean;
}

const { class: className = '', narrow = false } = Astro.props;
---

<div
  class:list={[
    'mx-auto w-full px-6 lg:px-[var(--anzuk-container-padding)]',
    narrow ? 'max-w-3xl' : 'max-w-anzuk-container',
    className,
  ]}
>
  <slot />
</div>
