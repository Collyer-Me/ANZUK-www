---
/**
 * Brand-colour duotone treatment for photography ("art direction as code").
 * Greyscales the image, multiplies the tone into the shadows, then colourises
 * — turns any photo into an on-brand visual without new assets.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../../styles/components.css';

type Tone = 'blue' | 'green' | 'purple';

interface Props {
  src: ImageMetadata;
  alt: string;
  tone?: Tone;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  tone = 'purple',
  widths = [480, 760, 1120],
  sizes = '(min-width: 1024px) 45vw, 92vw',
  loading = 'lazy',
  class: className = '',
} = Astro.props;
---

<div class:list={['az-duotone', className]} data-tone={tone}>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} class="az-duotone-img" />
</div>
