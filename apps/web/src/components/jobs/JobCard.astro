---
/**
 * Job listing card: school-initials avatar, type/featured badges, salary line,
 * and an express-interest CTA. `expressHref` should carry job context (e.g.
 * `?job=<title>` onto the expression-of-interest form).
 */
import arrowRight from '@anzuk/brand/assets/icons/arrow-right-blue.svg';
import Badge from '../ui/Badge.astro';
import Card from '../ui/Card.astro';
import type { DemoJob } from '../../data/demo-jobs';

interface Props {
  job: DemoJob;
  expressHref: string;
  class?: string;
}

const { job, expressHref, class: className = '' } = Astro.props;

const avatarStyles = [
  'bg-anzuk-extra-light-blue text-anzuk-blue',
  'bg-anzuk-extra-light-green text-anzuk-green',
  'bg-anzuk-extra-light-purple text-anzuk-purple',
  'bg-anzuk-light-yellow text-anzuk-title',
];

function hash(text: string): number {
  let value = 0;
  for (const char of text) value = (value * 31 + char.charCodeAt(0)) % 997;
  return value;
}

const avatarStyle = avatarStyles[hash(job.school) % avatarStyles.length];
const initials = job.school
  .split(' ')
  .map((word) => word[0])
  .filter((char) => /[A-Za-z]/.test(char ?? ''))
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<Card class:list={['group flex h-full flex-col p-6 transition hover:shadow-lg motion-safe:hover:-translate-y-1', className]}>
  <div class="flex items-start justify-between gap-3">
    <span
      class:list={['flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-sm font-bold', avatarStyle]}
      aria-hidden="true"
    >
      {initials}
    </span>
    <div class="flex flex-wrap justify-end gap-2">
      {job.featured && <Badge active>Featured</Badge>}
      <Badge class="border border-anzuk-light-gray">{job.typeLabel}</Badge>
    </div>
  </div>

  <h3 class="mt-4 !text-xl">{job.title}</h3>
  <p class="mt-1 text-sm text-anzuk-content">{job.school} · {job.location}</p>
  <p class="mt-3 font-semibold text-anzuk-title">{job.salary}</p>
  <p class="mt-2 flex-1 text-sm text-anzuk-content">{job.summary}</p>

  <div
    class="mt-5 flex items-center justify-between gap-3 border-t border-anzuk-light-gray pt-4 text-xs text-anzuk-icon-muted"
  >
    <span>Starts {job.startDate}</span>
    <span>Posted {job.posted}</span>
  </div>

  <a
    href={expressHref}
    class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-anzuk-blue no-underline hover:underline"
  >
    Express interest<span class="sr-only"> in {job.title}</span>
    <img
      src={arrowRight.src}
      alt=""
      width={arrowRight.width}
      height={arrowRight.height}
      class="h-3 w-3 motion-safe:transition-transform motion-safe:group-hover:translate-x-1"
      aria-hidden="true"
    />
  </a>
</Card>
