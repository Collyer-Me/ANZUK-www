---
import { personas } from '@anzuk/brand';
import arrowRight from '@anzuk/brand/assets/icons/arrow-right-blue.svg';
import Card from '../ui/Card.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { valueIcons } from './value-icons';
import { withBase } from '../../lib/url';

const personaMeta = {
  schools: {
    icon: valueIcons.relationships,
    accent: 'bg-anzuk-blue',
    cta: 'Schools enquiry',
    href: 'mailto:hello@anzuk.education?subject=Schools%20enquiry',
  },
  educators: {
    icon: valueIcons.growth,
    accent: 'bg-anzuk-green',
    cta: 'Expression of interest',
    href: withBase('/brand/demo/educators') + '#eoi',
  },
  leadership: {
    icon: valueIcons.empower,
    accent: 'bg-anzuk-purple',
    cta: 'Leadership search',
    href: 'mailto:hello@anzuk.education?subject=Leadership%20search',
  },
} as const;
---

<Section variant="white" aria-labelledby="personas-heading">
  <Container>
    <SectionHeading
      id="personas-heading"
      eyebrow="One team, three journeys"
      title="Who we help"
      description="Schools, educators, and boards each get a dedicated specialist — one relationship from first conversation to long after placement."
    />
    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        personas.map((persona, index) => {
          const meta = personaMeta[persona.id];
          return (
            <div data-reveal="up" data-reveal-delay={String(index * 120)} class="h-full">
              <Card
                variant="elevated"
                class="group flex h-full flex-col transition motion-safe:hover:-translate-y-1"
              >
                <div class={`h-1.5 ${meta.accent}`} aria-hidden="true" />
                <div class="flex flex-1 flex-col p-7">
                  <img
                    src={meta.icon.src}
                    alt=""
                    width={meta.icon.width}
                    height={meta.icon.height}
                    class="h-14 w-14 object-contain"
                    aria-hidden="true"
                  />
                  <h3 class="mt-5 !text-2xl">{persona.name}</h3>
                  <p class="mt-3 text-sm text-anzuk-content">{persona.description}</p>
                  <ul class="mt-5 space-y-2" role="list">
                    {persona.needs.map((need) => (
                      <li class="flex items-start gap-2 text-sm text-anzuk-content">
                        <svg
                          class="mt-0.5 h-4 w-4 shrink-0 text-anzuk-green"
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M2.5 8.5 6 12l7.5-8" />
                        </svg>
                        {need}
                      </li>
                    ))}
                  </ul>
                  <a
                    href={meta.href}
                    class="mt-auto inline-flex items-center gap-2 pt-7 font-semibold text-anzuk-blue no-underline hover:underline"
                  >
                    {meta.cta}
                    <img
                      src={arrowRight.src}
                      alt=""
                      width={arrowRight.width}
                      height={arrowRight.height}
                      class="h-3.5 w-3.5 motion-safe:transition-transform motion-safe:group-hover:translate-x-1"
                      aria-hidden="true"
                    />
                  </a>
                </div>
              </Card>
            </div>
          );
        })
      }
    </div>
  </Container>
</Section>
