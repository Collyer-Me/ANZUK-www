---
interface Props {
  group: 'region' | 'type';
  value: string;
  label: string;
  pressed?: boolean;
}

const { group, value, label, pressed = false } = Astro.props;
---

<button
  type="button"
  data-filter-group={group}
  data-filter-value={value}
  aria-pressed={pressed ? 'true' : 'false'}
  class="demo-filter-pill rounded-full border-2 border-anzuk-light-gray bg-white px-4 py-1.5 text-sm font-semibold text-anzuk-content transition-colors hover:border-anzuk-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-anzuk-blue"
>
  {label}
</button>
