---
import Container from '../ui/Container.astro';
import FeatureCard from '../ui/FeatureCard.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { FeatureGridBlock } from '../../lib/cms/types';

interface Props {
  block: FeatureGridBlock;
}

const { block } = Astro.props;

const iconMap: Record<string, string> = {
  teaching: '📚',
  support: '🤝',
  global: '🌏',
  community: '👥',
};
---

<Section variant="white" aria-labelledby={`features-${block.id}`}>
  <Container>
    {block.heading && (
      <SectionHeading
        id={`features-${block.id}`}
        title={block.heading}
        level="h2"
        class="mb-12"
      />
    )}
    <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {
        block.features?.map((feature) => (
          <li>
            <FeatureCard
              title={feature.title}
              description={feature.description}
              iconEmoji={iconMap[feature.icon ?? 'teaching']}
            />
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
