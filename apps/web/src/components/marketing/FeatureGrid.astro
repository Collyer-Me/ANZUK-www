---
import type { FeatureGridBlock } from '../../lib/strapi/types';

interface Props {
  block: FeatureGridBlock;
}

const { block } = Astro.props;

const iconMap: Record<string, string> = {
  teaching: '📚',
  support: '🤝',
  global: '🌏',
  community: '👥',
};
---

<section class="bg-white px-6 py-20 lg:px-[72px]" aria-labelledby={`features-${block.id}`}>
  <div class="mx-auto max-w-anzuk-container">
    {block.heading && (
      <h2 id={`features-${block.id}`} class="mb-12 text-center">
        {block.heading}
      </h2>
    )}
    <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {
        block.features?.map((feature) => (
          <li class="rounded-2xl border border-anzuk-light-gray bg-anzuk-page-bg p-8">
            <span class="text-3xl" aria-hidden="true">
              {iconMap[feature.icon ?? 'teaching']}
            </span>
            <h3 class="mt-4 !text-2xl">{feature.title}</h3>
            {feature.description && (
              <p class="mt-3 text-anzuk-content">{feature.description}</p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
