---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import type { StatsRowBlock } from '../../lib/cms/types';

interface Props {
  block: StatsRowBlock;
}

const { block } = Astro.props;
---

<Section variant="lightBlue" aria-labelledby={`stats-${block.id}`}>
  <Container>
    <h2 id={`stats-${block.id}`} class="sr-only">Key statistics</h2>
    <ul class="grid gap-8 text-center sm:grid-cols-2 lg:grid-cols-4" role="list">
      {
        block.stats?.map((stat) => (
          <li>
            <p class="text-4xl font-bold text-anzuk-blue">{stat.value}</p>
            <p class="mt-2 text-sm font-medium text-anzuk-content">{stat.label}</p>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
