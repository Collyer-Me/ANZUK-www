---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { FormEmbedBlock } from '../../lib/strapi/types';

interface Props {
  block: FormEmbedBlock;
}

const { block } = Astro.props;
const embedUrl = `https://form.jotform.com/${block.jotformId}`;
const height = block.height ?? 600;
---

<Section variant="white" aria-labelledby={`form-${block.id}`}>
  <Container>
    {
      (block.heading || block.description) && (
        <SectionHeading
          id={`form-${block.id}`}
          title={block.heading ?? 'Get in touch'}
          description={block.description}
          level="h2"
          class="mb-8 [&_h2]:!text-[clamp(2rem,4vw,3.8rem)]"
        />
      )
    }
    <iframe
      title={block.heading ?? 'Contact form'}
      src={embedUrl}
      width="100%"
      height={height}
      class="rounded-anzuk-card border border-anzuk-light-gray"
      loading="lazy"
    />
  </Container>
</Section>
