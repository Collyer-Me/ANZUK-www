---
/**
 * Closing call-to-action band on dark purple with a low-opacity parallax blob.
 */
import heroBlob from '@anzuk/brand/assets/illustrations/hero-blob-light-blue.svg';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';

interface Props {
  heading: string;
  body?: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  class?: string;
}

const { heading, body, primaryLabel, primaryHref, secondaryLabel, secondaryHref, class: className = '' } = Astro.props;
---

<Section variant="darkPurple" class:list={['relative overflow-hidden', className]}>
  <img
    src={heroBlob.src}
    alt=""
    width={heroBlob.width}
    height={heroBlob.height}
    class="pointer-events-none absolute -right-36 -top-44 w-[640px] max-w-none opacity-20"
    data-parallax="0.05"
    aria-hidden="true"
  />
  <Container class="relative text-center">
    <h2 data-reveal="up" class="!mt-0">{heading}</h2>
    {
      body && (
        <p data-reveal="up" data-reveal-delay="100" class="mx-auto mt-5 max-w-2xl text-anzuk-light-gray">
          {body}
        </p>
      )
    }
    <div data-reveal="up" data-reveal-delay="200" class="mt-10 flex flex-wrap justify-center gap-4">
      <Button variant="light" href={primaryHref}>{primaryLabel}</Button>
      {
        secondaryLabel && secondaryHref && (
          <Button variant="secondary" href={secondaryHref}>
            {secondaryLabel}
          </Button>
        )
      }
    </div>
  </Container>
</Section>
