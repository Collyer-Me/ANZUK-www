---
/**
 * Numbered how-it-works strip with a single continuous connector line that
 * draws in behind the step circles (md+).
 */
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';

export interface Step {
  title: string;
  description: string;
}

interface Props {
  steps: readonly Step[];
  eyebrow?: string;
  title: string;
  description?: string;
  background?: 'page' | 'white';
  id?: string;
  class?: string;
}

const {
  steps,
  eyebrow = 'How it works',
  title,
  description,
  background = 'page',
  id = 'steps-heading',
  class: className = '',
} = Astro.props;

/* The ring colour masks the connector line where it passes behind circles. */
const ringClass = background === 'white' ? 'ring-white' : 'ring-anzuk-page-bg';
---

<Section variant={background} class={className} aria-labelledby={id}>
  <Container>
    <SectionHeading id={id} eyebrow={eyebrow} title={title} description={description} />
    <div class="relative mt-14">
      <div
        class="absolute left-6 right-6 top-6 hidden h-0.5 -translate-y-1/2 bg-anzuk-light-blue md:block"
        data-reveal="draw"
        data-reveal-delay="250"
        aria-hidden="true"
      >
      </div>
      <ol class:list={['relative grid gap-10', steps.length === 4 ? 'md:grid-cols-4' : 'md:grid-cols-3']} role="list">
        {
          steps.map((step, index) => (
            <li data-reveal="up" data-reveal-delay={String(index * 150)}>
              <span
                class:list={[
                  'relative z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-anzuk-blue text-xl font-bold text-white ring-4',
                  ringClass,
                ]}
              >
                {index + 1}
              </span>
              <h3 class="mt-6 !text-xl">{step.title}</h3>
              <p class="mt-2 text-sm text-anzuk-content">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Container>
</Section>
