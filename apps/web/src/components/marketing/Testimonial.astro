---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import type { TestimonialBlock } from '../../lib/strapi/types';

interface Props {
  block: TestimonialBlock;
}

const { block } = Astro.props;
---

<Section variant="page" aria-labelledby={`testimonial-${block.id}`}>
  <Container narrow>
    <figure class="text-center">
      <blockquote>
        <p id={`testimonial-${block.id}`} class="text-2xl font-medium leading-relaxed text-anzuk-title">
          &ldquo;{block.quote}&rdquo;
        </p>
      </blockquote>
      <figcaption class="mt-6">
        <cite class="not-italic">
          <span class="font-semibold text-anzuk-title">{block.authorName}</span>
          {block.authorRole && (
            <span class="text-anzuk-content"> — {block.authorRole}</span>
          )}
        </cite>
      </figcaption>
    </figure>
  </Container>
</Section>
