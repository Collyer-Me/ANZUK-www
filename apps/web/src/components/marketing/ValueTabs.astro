---
/**
 * BE GREAT letter tabs with one panel per value.
 * All panels are server-rendered; non-active ones are hidden only when JS is
 * available, so no-JS visitors see the full list. Optional auto-advance
 * (default on) cycles every 5s, pauses on hover/focus, stops permanently on
 * manual selection, and never runs under prefers-reduced-motion.
 */
import type { ImageMetadata } from 'astro';
import ValuePanel from '../ui/ValuePanel.astro';
import '../../styles/components.css';

export interface ValueTab {
  letter: string;
  word: string;
  summary: string;
  icon: ImageMetadata;
}

interface Props {
  values: readonly ValueTab[];
  label?: string;
  autoAdvance?: boolean;
  class?: string;
}

const { values, label = 'BE GREAT values', autoAdvance = true, class: className = '' } = Astro.props;
---

<div class={className} data-value-tabs data-auto-advance={autoAdvance ? 'true' : 'false'}>
  <div role="tablist" aria-label={label} class="flex flex-wrap gap-2">
    {
      values.map((value, index) => (
        <button
          type="button"
          role="tab"
          id={`value-tab-${index}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`value-panel-${index}`}
          tabindex={index === 0 ? 0 : -1}
          class="flex h-11 w-11 items-center justify-center rounded-full border-2 border-anzuk-green bg-white text-lg font-bold text-anzuk-green transition-colors hover:bg-anzuk-extra-light-green focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-anzuk-green aria-selected:bg-anzuk-green aria-selected:text-white"
        >
          {value.letter}
          <span class="sr-only"> — {value.word}</span>
        </button>
      ))
    }
  </div>

  <div class="mt-6">
    {
      values.map((value, index) => (
        <div
          role="tabpanel"
          id={`value-panel-${index}`}
          aria-labelledby={`value-tab-${index}`}
          class="az-value-panel"
          data-active={index === 0 ? 'true' : undefined}
        >
          <ValuePanel title={value.word.toUpperCase()} description={value.summary} icon={value.icon} active={true} />
        </div>
      ))
    }
  </div>
</div>

<script>
  const AUTO_ADVANCE_MS = 5000;

  function initValueTabs(): void {
    const root = document.querySelector<HTMLElement>('[data-value-tabs]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const select = (index: number, focus = false) => {
      current = index;
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        if (i === index) {
          panel.setAttribute('data-active', 'true');
        } else {
          panel.removeAttribute('data-active');
        }
      });
      if (focus) tabs[index].focus();
    };

    const stopAuto = () => {
      if (timer !== undefined) {
        clearInterval(timer);
        timer = undefined;
      }
    };

    const startAuto = () => {
      if (timer !== undefined || reducedQuery.matches || root.dataset.autoAdvance !== 'true') return;
      timer = setInterval(() => {
        if (!root.isConnected) {
          stopAuto();
          return;
        }
        select((current + 1) % tabs.length);
      }, AUTO_ADVANCE_MS);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        // A deliberate choice ends the slideshow.
        root.dataset.autoAdvance = 'false';
        stopAuto();
        select(index);
      });
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        let next: number | null = null;
        if (event.key === 'ArrowRight') next = index === last ? 0 : index + 1;
        else if (event.key === 'ArrowLeft') next = index === 0 ? last : index - 1;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = last;
        if (next !== null) {
          event.preventDefault();
          root.dataset.autoAdvance = 'false';
          stopAuto();
          select(next, true);
        }
      });
    });

    root.addEventListener('pointerenter', stopAuto);
    root.addEventListener('pointerleave', startAuto);
    root.addEventListener('focusin', stopAuto);
    root.addEventListener('focusout', startAuto);
    reducedQuery.addEventListener('change', (event) => {
      if (event.matches) stopAuto();
    });

    startAuto();
  }

  initValueTabs();
  document.addEventListener('astro:after-swap', initValueTabs);
</script>
