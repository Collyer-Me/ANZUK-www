---
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { HeroBlock } from '../../lib/strapi/types';

interface Props {
  block: HeroBlock;
}

const { block } = Astro.props;
const isDark = block.variant === 'dark';
---

<Section
  variant={isDark ? 'darkPurple' : 'page'}
  aria-labelledby={`hero-${block.id}`}
>
  <Container class="text-center">
    <SectionHeading
      id={`hero-${block.id}`}
      title={block.heading}
      description={block.subheading}
      level="h1"
      dark={isDark}
    />
    {block.ctaLabel && block.ctaUrl && (
      <div class="mt-10">
        <Button variant={isDark ? 'light' : 'primary'} href={block.ctaUrl}>
          {block.ctaLabel}
        </Button>
      </div>
    )}
  </Container>
</Section>
