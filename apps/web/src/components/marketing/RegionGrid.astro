---
import RegionGridBand from './RegionGridBand.astro';
import type { RegionGridBlock } from '../../lib/strapi/types';

interface Props {
  block: RegionGridBlock;
}

const { block } = Astro.props;
---

<RegionGridBand
  id={`region-grid-${block.id}`}
  heading={block.heading}
  subheading={block.subheading}
  regions={block.regions ?? []}
/>
