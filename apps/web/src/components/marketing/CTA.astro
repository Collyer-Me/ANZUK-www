---
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { CtaBlock } from '../../lib/strapi/types';

interface Props {
  block: CtaBlock;
}

const { block } = Astro.props;
const isDark = block.variant === 'dark';
---

<Section
  variant={isDark ? 'darkPurple' : 'lightBlue'}
  padding="compact"
  aria-labelledby={`cta-${block.id}`}
>
  <Container class="text-center">
    <SectionHeading
      id={`cta-${block.id}`}
      title={block.heading}
      description={block.body}
      level="h2"
      dark={isDark}
      class="[&_h2]:!text-[clamp(2rem,4vw,3.8rem)]"
    />
    <div class="mt-8">
      <Button variant={isDark ? 'light' : 'primary'} href={block.buttonUrl}>
        {block.buttonLabel}
      </Button>
    </div>
  </Container>
</Section>
