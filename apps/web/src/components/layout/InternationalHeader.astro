---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Logo from '../ui/Logo.astro';
import { REGIONS } from '../../config/regions';
import { SCOOT_US } from '../../config/markets';
import { getAllInternationalPages } from '../../lib/strapi/queries/pages';

const intlPages = (await getAllInternationalPages()).filter((p) => p.slug !== 'home');
---

<header class="border-b border-anzuk-light-gray bg-white">
  <div class="mx-auto flex max-w-anzuk-container flex-col gap-4 px-6 py-4 lg:flex-row lg:items-center lg:justify-between lg:px-[72px]">
    <a href="/" aria-label="ANZUK Education home">
      <Logo class="h-8 w-auto" />
    </a>
    <nav aria-label="International" class="flex flex-wrap gap-2 text-sm">
      {
        intlPages.map((p) => (
          <a
            href={`/${p.slug}/`}
            class="rounded-full px-3 py-1 text-anzuk-content no-underline hover:bg-anzuk-extra-light-blue"
          >
            {p.title}
          </a>
        ))
      }
    </nav>
    <nav aria-label="Regional sites">
      <ul class="flex flex-wrap items-center gap-2 text-sm">
        {
          REGIONS.map((r) => (
            <li>
              <a
                href={getRelativeLocaleUrl(r.path, '/')}
                class="rounded-full px-3 py-1 text-anzuk-content no-underline hover:bg-anzuk-extra-light-blue"
                hreflang={r.hreflang}
                lang={r.htmlLang}
              >
                <span aria-hidden="true">{r.flag}</span> {r.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={SCOOT_US.url}
            class="rounded-full px-3 py-1 text-anzuk-content no-underline hover:bg-anzuk-extra-light-blue"
            hreflang={SCOOT_US.hreflang}
            lang={SCOOT_US.htmlLang}
            rel="noopener noreferrer"
          >
            <span aria-hidden="true">{SCOOT_US.flag}</span> {SCOOT_US.label}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
