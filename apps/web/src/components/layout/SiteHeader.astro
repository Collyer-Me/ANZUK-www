---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Logo from '../ui/Logo.astro';
import MainNav from './MainNav.astro';
import { getNavigationForMarket } from '../../lib/strapi/queries/market-navigations';
import { REGIONS, type RegionPath } from '../../config/regions';
import { SCOOT_US } from '../../config/markets';

interface Props {
  region: RegionPath;
}

const { region } = Astro.props;
const navItems = await getNavigationForMarket(region);
---

<header class="border-b border-anzuk-light-gray bg-white">
  <div class="mx-auto flex max-w-anzuk-container flex-col gap-4 px-6 py-4 lg:px-[72px]">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <a href={getRelativeLocaleUrl(region, '/')} aria-label="ANZUK Education home">
        <Logo class="h-8 w-auto" />
      </a>
      {navItems.length > 0 && (
        <MainNav market={region} items={navItems} ariaLabel="Main navigation" />
      )}
    </div>
    <nav aria-label="Regional sites">
      <ul class="flex flex-wrap items-center gap-2 text-sm">
        <li>
          <a href="/" class="rounded-full px-3 py-1 text-anzuk-content no-underline hover:bg-anzuk-extra-light-blue">
            International
          </a>
        </li>
        {
          REGIONS.map((r) => (
            <li>
              <a
                href={getRelativeLocaleUrl(r.path, '/')}
                class:list={[
                  'rounded-full px-3 py-1 no-underline transition-colors',
                  r.path === region
                    ? 'bg-anzuk-blue font-semibold text-white'
                    : 'text-anzuk-content hover:bg-anzuk-extra-light-blue',
                ]}
                hreflang={r.hreflang}
                lang={r.htmlLang}
              >
                <span aria-hidden="true">{r.flag}</span> {r.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={SCOOT_US.url}
            class="rounded-full px-3 py-1 text-anzuk-content no-underline hover:bg-anzuk-extra-light-blue"
            hreflang={SCOOT_US.hreflang}
            lang={SCOOT_US.htmlLang}
            rel="noopener noreferrer"
          >
            <span aria-hidden="true">{SCOOT_US.flag}</span> {SCOOT_US.label}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
