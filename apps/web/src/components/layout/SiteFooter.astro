---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { RegionPath } from '../../config/regions';
import type { SiteSettings } from '../../lib/strapi/types';
import { withBase } from '../../lib/url';

interface Props {
  region?: RegionPath;
  settings: SiteSettings;
}

const { region, settings } = Astro.props;
const year = new Date().getFullYear();
const homeHref = region ? getRelativeLocaleUrl(region, '/') : '/';
---

<footer class="border-t border-anzuk-light-gray bg-anzuk-dark-purple px-6 py-10 text-anzuk-light-gray lg:px-[72px]">
  <div class="mx-auto flex max-w-anzuk-container flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm">
      &copy; {year} {settings.siteName}. All rights reserved.
    </p>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-4 text-sm">
        <li>
          <a href={homeHref} class="text-anzuk-light-blue no-underline hover:underline">
            Home
          </a>
        </li>
        {
          settings.scootUrl && (
            <li>
              <a
                href={settings.scootUrl}
                class="text-anzuk-light-blue no-underline hover:underline"
                rel="noopener noreferrer"
              >
                Scoot Education (US)
              </a>
            </li>
          )
        }
        <li>
          <a href={withBase('/brand')} class="text-anzuk-light-blue no-underline hover:underline" rel="nofollow">
            Brand guide
          </a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
