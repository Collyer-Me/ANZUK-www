---
import JsonLd from './JsonLd.astro';
import { getSiteUrl, siteConfig } from '../../config/site';
import { getRegionByPath, type RegionPath } from '../../config/regions';
import { buildCanonicalUrl } from '../../lib/seo/urls';
import type { CmsPage } from '../../lib/cms/types';

interface Props {
  region: RegionPath;
  page: CmsPage;
}

const { region, page } = Astro.props;
const regionConfig = getRegionByPath(region)!;
const siteUrl = getSiteUrl();
const pageUrl = buildCanonicalUrl(region, page.path);

const schema = {
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: page.seo?.metaTitle ?? page.title,
  description: page.seo?.metaDescription ?? undefined,
  inLanguage: regionConfig.hreflang,
  isPartOf: { '@id': `${siteUrl}/${siteConfig.websiteId}` },
};
---

<JsonLd schema={schema} />
