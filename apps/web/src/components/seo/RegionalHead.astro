---
import { getRegionByPath, type RegionPath } from '../../config/regions';
import { absolutePageUrl, buildCanonicalUrl, xDefaultUrl } from '../../lib/seo/urls';
import { resolvePageOgImageAlt, resolvePageOgImageUrl } from '../../lib/seo/og-image';
import { assetWithBase } from '../../lib/url';
import type { CmsPage, GlobalSettings, StrapiMedia } from '../../lib/cms/types';
import { buildAlternates } from '../../lib/cms/pages';

interface Props {
  region: RegionPath;
  page: CmsPage;
  settings?: GlobalSettings;
  ogImageFallback?: StrapiMedia | null;
}

const { region, page, settings, ogImageFallback } = Astro.props;
const regionConfig = getRegionByPath(region)!;
const alternates = buildAlternates(page, region);
const title = page.seo?.metaTitle ?? page.title;
const description = page.seo?.metaDescription ?? '';
const canonical = buildCanonicalUrl(region, page.path);
const ogImageUrl = resolvePageOgImageUrl(page, settings, ogImageFallback);
const ogImageAlt = resolvePageOgImageAlt(page, settings, ogImageFallback);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{page.noIndex && <meta name="robots" content="noindex, nofollow" />}
<link rel="icon" href={assetWithBase('/favicon.svg')} type="image/svg+xml" />
<link rel="canonical" href={canonical} />
{
  alternates.map((alt) => (
    <link
      rel="alternate"
      hreflang={alt.hreflang}
      href={absolutePageUrl(alt.path, alt.slug)}
    />
  ))
}
<link rel="alternate" hreflang="x-default" href={xDefaultUrl()} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={regionConfig.hreflang.replace('-', '_')} />
<meta property="og:type" content="website" />
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
{ogImageUrl && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
{ogImageUrl && <meta name="twitter:card" content="summary_large_image" />}
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
