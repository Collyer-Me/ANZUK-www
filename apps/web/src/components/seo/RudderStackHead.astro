---
import type { GlobalSettings } from '../../lib/strapi/types';
import { rudderStackConfigFromSettings } from '../../lib/strapi/queries/global-settings';

interface Props {
  settings: GlobalSettings;
  regionCode: string;
  locale?: string;
  pageType: string;
  pagePath: string;
}

const { settings, regionCode, locale = 'en', pageType, pagePath } = Astro.props;
const rs = rudderStackConfigFromSettings(settings);
const optionalGtm = settings.optionalGtmContainerId;

const rudderConfig =
  rs.enabled && rs.writeKey && rs.dataPlaneUrl
    ? {
        writeKey: rs.writeKey,
        dataPlaneUrl: rs.dataPlaneUrl,
        regionCode,
        locale,
        pageType,
        pagePath,
      }
    : null;
---

{
  rudderConfig && (
    <>
      <script
        is:inline
        type="application/json"
        id="anzuk-rudder-config"
        set:html={JSON.stringify(rudderConfig)}
      />
      <script>
        import { mountRudderStackHead } from '../../lib/analytics/rudder-init';

        const configEl = document.getElementById('anzuk-rudder-config');
        if (configEl?.textContent) {
          mountRudderStackHead(JSON.parse(configEl.textContent));
        }
      </script>
    </>
  )
}

{
  optionalGtm && (
    <script is:inline define:vars={{ gtmId: optionalGtm }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>
  )
}
