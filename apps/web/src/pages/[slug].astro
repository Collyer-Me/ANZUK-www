---
import InternationalLayout from '../layouts/InternationalLayout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import JobListingPlaceholder from '../components/jobs/JobListingPlaceholder.astro';
import { INTERNATIONAL_MARKET } from '../config/markets';
import { REGION_PATHS, isValidRegion } from '../config/regions';
import { routeParam } from '../lib/astro/route-params';
import {
  getAllInternationalPages,
  getPageByMarketAndSlug,
} from '../lib/cms/pages';
import { getGlobalSettings } from '../lib/cms/settings';

/** Only match explicit international slugs — not /au/, /uk/, etc. */
export const prerender = true;

export async function getStaticPaths() {
  const pages = await getAllInternationalPages();
  const reserved = new Set([...REGION_PATHS, 'brand']);

  return pages
    .filter((p) => p.path !== 'home' && !reserved.has(p.path.split('/')[0]!))
    .map((p) => ({
      params: { slug: p.path },
      props: { slug: p.path },
    }));
}

const slug = routeParam(Astro.params, Astro.props, 'slug');

// Avoid collision with regional home routes (/au/, /uk/, …) in SSR dev.
if (!slug || isValidRegion(slug) || slug === 'brand') {
  return Astro.redirect('/404');
}

const page = await getPageByMarketAndSlug(INTERNATIONAL_MARKET, slug);

if (!page) {
  return Astro.redirect('/404');
}

const settings = await getGlobalSettings();
---

<InternationalLayout {page} {settings}>
  <article>
    <BlockRenderer blocks={page.body} regionCode="international" />
    {page.pageType === 'job-listing' && <JobListingPlaceholder config={page.jobBoardConfig} />}
  </article>
</InternationalLayout>
