---
import RegionalLayout from '../../layouts/RegionalLayout.astro';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
import JobListingPlaceholder from '../../components/jobs/JobListingPlaceholder.astro';
import { getRegionByPath, isValidRegion, type RegionPath } from '../../config/regions';
import { getAllRegionalPages, getPageByMarketAndSlug } from '../../lib/strapi/queries/pages';
import { getSiteSettings } from '../../lib/strapi/queries/site-settings';

export async function getStaticPaths() {
  const allPages = await getAllRegionalPages();

  return allPages
    .filter((p) => p.slug !== 'home' && p.slug !== 'blog')
    .map((p) => ({
      params: { region: p.region, slug: p.slug },
      props: { region: p.region, slug: p.slug },
    }));
}

interface Props {
  region: RegionPath;
  slug: string;
}

const { region, slug: slugParam } = Astro.props;
const slug = Array.isArray(slugParam) ? slugParam.join('/') : slugParam;

if (!isValidRegion(region)) {
  return Astro.redirect('/404');
}

const regionConfig = getRegionByPath(region)!;
const page = await getPageByMarketAndSlug(region, slug);

if (!page) {
  return Astro.redirect('/404');
}

const settings = await getSiteSettings(regionConfig.strapiLocale);
---

<RegionalLayout {region} {page} {settings}>
  <article>
    <BlockRenderer blocks={page.body} />
    {page.pageTemplate === 'job-listing' && <JobListingPlaceholder config={page.jobBoardConfig} />}
  </article>
</RegionalLayout>
