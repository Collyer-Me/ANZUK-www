---
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import type { SbBlokData } from '@storyblok/astro';
import RegionalLayout from '../../layouts/RegionalLayout.astro';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
import JobListingPlaceholder from '../../components/jobs/JobListingPlaceholder.astro';
import { isValidRegion } from '../../config/regions';
import { routeParam, routeSlug } from '../../lib/astro/route-params';
import { getAllRegionalPages, getPageByMarketAndSlug } from '../../lib/cms/pages';
import { getGlobalSettings } from '../../lib/cms/settings';
import { cmsPageFromStory, fetchPilotStory } from '../../lib/storyblok';

export async function getStaticPaths() {
  const allPages = await getAllRegionalPages();

  return allPages
    .filter((p) => p.slug !== 'home' && p.slug !== 'blog')
    .map((p) => ({
      params: { region: p.region, slug: p.slug },
      props: { region: p.region, slug: p.slug },
    }));
}

const region = routeParam(Astro.params, Astro.props, 'region');
const slug = routeSlug(Astro.params, Astro.props);

if (!region || !isValidRegion(region)) {
  return Astro.redirect('/404');
}

const pilotSlug = region === 'au' && slug === 'who-we-are' ? 'au/who-we-are' : null;
const story = pilotSlug ? await fetchPilotStory(pilotSlug, Astro.locals) : null;
const fallbackPage = await getPageByMarketAndSlug(region, slug);

if (!story && !fallbackPage) {
  return Astro.redirect('/404');
}

const page = story ? cmsPageFromStory(story, region) : fallbackPage!;
const settings = await getGlobalSettings();
---

<RegionalLayout {region} {page} {settings}>
  <article>
    {
      story ? (
        <StoryblokComponent blok={story.content as SbBlokData} />
      ) : (
        <BlockRenderer blocks={fallbackPage!.body} regionCode={region} />
      )
    }
    {page.pageType === 'job-listing' && <JobListingPlaceholder config={page.jobBoardConfig} />}
  </article>
</RegionalLayout>
