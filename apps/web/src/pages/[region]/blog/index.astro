---
import RegionalLayout from '../../../layouts/RegionalLayout.astro';
import { getRegionByPath, isValidRegion, REGIONS, type RegionPath } from '../../../config/regions';
import { getArticlesByMarket } from '../../../lib/strapi/queries/articles';
import { getPageByMarketAndSlug } from '../../../lib/strapi/queries/pages';
import { getSiteSettings } from '../../../lib/strapi/queries/site-settings';

export async function getStaticPaths() {
  return REGIONS.map((region) => ({
    params: { region: region.path },
    props: { region: region.path },
  }));
}

interface Props {
  region: RegionPath;
}

const { region } = Astro.props;

if (!isValidRegion(region)) {
  return Astro.redirect('/404');
}

const regionConfig = getRegionByPath(region)!;
const page =
  (await getPageByMarketAndSlug(region, 'blog')) ??
  ({
    documentId: `mock-${region}-blog`,
    title: 'Blog',
    slug: 'blog',
    market: region,
    pageTemplate: 'blog-listing' as const,
    seo: { metaTitle: `Blog - ANZUK Education`, metaDescription: null, ogImage: null },
    body: [],
  });

const articles = await getArticlesByMarket(region);
const settings = await getSiteSettings(regionConfig.strapiLocale);
---

<RegionalLayout {region} page={page} {settings}>
  <article class="mx-auto max-w-anzuk-container px-6 py-10 lg:px-[72px]">
    <h1 class="!mt-0">Blog</h1>
    <ul class="mt-8 space-y-4" role="list">
      {
        articles.map((article) => (
          <li>
            <a
              href={`/${region}/blog/${article.slug}/`}
              class="block rounded-2xl border border-anzuk-light-gray p-5 no-underline hover:shadow-md"
            >
              <h2 class="!mt-0 !text-xl text-anzuk-title">{article.title}</h2>
              {article.excerpt && <p class="mt-2 text-anzuk-content">{article.excerpt}</p>}
            </a>
          </li>
        ))
      }
    </ul>
  </article>
</RegionalLayout>
