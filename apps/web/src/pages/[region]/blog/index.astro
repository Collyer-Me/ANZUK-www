---
import RegionalLayout from '../../../layouts/RegionalLayout.astro';
import { isValidRegion, REGIONS } from '../../../config/regions';
import { routeParam } from '../../../lib/astro/route-params';
import { getArticlesByMarket } from '../../../lib/cms/articles';
import { getPageByMarketAndSlug } from '../../../lib/cms/pages';
import { getGlobalSettings } from '../../../lib/cms/settings';
import { strapiMediaUrl } from '../../../lib/cms/media-url';
import type { CmsPage } from '../../../lib/cms/types';

export const prerender = true;

export async function getStaticPaths() {
  return REGIONS.map((region) => ({
    params: { region: region.path },
    props: { region: region.path },
  }));
}

const region = routeParam(Astro.params, Astro.props, 'region');

if (!region || !isValidRegion(region)) {
  return Astro.redirect('/404');
}

const page: CmsPage =
  (await getPageByMarketAndSlug(region, 'blog')) ??
  ({
    documentId: `mock-${region}-blog`,
    title: 'Blog',
    slug: 'blog',
    path: 'blog',
    regionCode: region,
    pageType: 'blog-listing',
    seo: { metaTitle: `Blog - ANZUK Education`, metaDescription: null, ogImage: null },
    body: [],
  });

const articles = await getArticlesByMarket(region);
const settings = await getGlobalSettings();
---

<RegionalLayout {region} {page} {settings}>
  <article class="mx-auto max-w-anzuk-container px-6 py-10 lg:px-[72px]">
    <h1 class="!mt-0">Blog</h1>
    <ul class="mt-8 space-y-4" role="list">
      {
        articles.map((article) => {
          const imageUrl = strapiMediaUrl(article.featuredImage);
          const imageAlt = article.featuredImage?.alternativeText ?? article.title;
          return (
            <li>
              <a
                href={`/${region}/blog/${article.slug}/`}
                class="flex gap-5 rounded-2xl border border-anzuk-light-gray p-5 no-underline hover:shadow-md"
              >
                {
                  imageUrl && (
                    <img
                      src={imageUrl}
                      alt={imageAlt}
                      width={120}
                      height={80}
                      class="h-20 w-[7.5rem] shrink-0 rounded-xl object-cover"
                      loading="lazy"
                    />
                  )
                }
                <div class="min-w-0">
                  <h2 class="!mt-0 !text-xl text-anzuk-title">{article.title}</h2>
                  {article.excerpt && <p class="mt-2 text-anzuk-content">{article.excerpt}</p>}
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </article>
</RegionalLayout>
