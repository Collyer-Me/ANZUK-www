---
import RegionalLayout from '../../../layouts/RegionalLayout.astro';
import { isValidRegion } from '../../../config/regions';
import { routeParam } from '../../../lib/astro/route-params';
import { getAllArticles, getArticleByMarketAndSlug } from '../../../lib/cms/articles';
import { getGlobalSettings } from '../../../lib/cms/settings';
import { strapiMediaUrl } from '../../../lib/cms/media-url';
import type { CmsPage } from '../../../lib/cms/types';

export const prerender = true;

export async function getStaticPaths() {
  const articles = await getAllArticles();

  return articles.map((a) => ({
    params: { region: a.region, slug: a.slug },
    props: { region: a.region, slug: a.slug },
  }));
}

const region = routeParam(Astro.params, Astro.props, 'region');
const slug = routeParam(Astro.params, Astro.props, 'slug');

if (!region || !isValidRegion(region) || !slug) {
  return Astro.redirect('/404');
}

const article = await getArticleByMarketAndSlug(region, slug);

if (!article) {
  return Astro.redirect('/404');
}

const pageShell: CmsPage = {
  documentId: article.documentId,
  title: article.title,
  slug: article.slug,
  path: `blog/${article.slug}`,
  regionCode: region,
  pageType: 'blog-article',
  seo: article.seo,
};

const settings = await getGlobalSettings();
const featuredImageUrl = strapiMediaUrl(article.featuredImage);
const featuredImageAlt = article.featuredImage?.alternativeText ?? article.title;
---

<RegionalLayout {region} page={pageShell} {settings} ogImageFallback={article.featuredImage}>
  <article class="mx-auto max-w-anzuk-container px-6 py-10 lg:px-[72px]">
    <p class="text-sm">
      <a href={`/${region}/blog/`} class="text-anzuk-blue no-underline hover:underline">
        &larr; Back to blog
      </a>
    </p>
    <h1 class="!mt-4">{article.title}</h1>
    {article.excerpt && <p class="text-lg text-anzuk-content">{article.excerpt}</p>}
    {
      featuredImageUrl && (
        <img
          src={featuredImageUrl}
          alt={featuredImageAlt}
          width={article.featuredImage?.width ?? undefined}
          height={article.featuredImage?.height ?? undefined}
          class="mt-8 w-full rounded-anzuk-card object-cover"
          loading="eager"
        />
      )
    }
    {article.body && <div class="prose mt-8 max-w-none" set:html={article.body} />}
  </article>
</RegionalLayout>
