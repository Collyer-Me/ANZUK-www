---
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import type { SbBlokData } from '@storyblok/astro';
import RegionalLayout from '../../layouts/RegionalLayout.astro';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
import { REGIONS, isValidRegion, type RegionPath } from '../../config/regions';
import { routeParam } from '../../lib/astro/route-params';
import { getPageByMarketAndSlug } from '../../lib/cms/pages';
import { getGlobalSettings } from '../../lib/cms/settings';
import { cmsPageFromStory, fetchPilotStory } from '../../lib/storyblok';

export async function getStaticPaths() {
  return REGIONS.map((region) => ({
    params: { region: region.path },
    props: { region: region.path },
  }));
}

const region = routeParam(Astro.params, Astro.props, 'region');

if (!region || !isValidRegion(region)) {
  return Astro.redirect('/404');
}

const story = region === 'au' ? await fetchPilotStory('au/home', Astro.locals) : null;
const fallbackPage = await getPageByMarketAndSlug(region, 'home');

if (!story && !fallbackPage) {
  return Astro.redirect('/404');
}

const page = story ? cmsPageFromStory(story, region) : fallbackPage!;
const settings = await getGlobalSettings();
---

<RegionalLayout {region} {page} {settings}>
  <article>
    {
      story ? (
        <StoryblokComponent blok={story.content as SbBlokData} />
      ) : (
        <BlockRenderer blocks={fallbackPage!.body} regionCode={region} />
      )
    }
  </article>
</RegionalLayout>
