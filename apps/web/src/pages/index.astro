---
import InternationalLayout from '../layouts/InternationalLayout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { INTERNATIONAL_MARKET } from '../config/markets';
import { getPageByMarketAndSlug } from '../lib/cms/pages';
import { getGlobalSettings } from '../lib/cms/settings';

const page = await getPageByMarketAndSlug(INTERNATIONAL_MARKET, 'home');

if (!page) {
  return Astro.redirect('/404');
}

const settings = await getGlobalSettings();
---

<InternationalLayout {page} {settings}>
  <article>
    <BlockRenderer blocks={page.body} regionCode="international" />
  </article>
</InternationalLayout>
