---
import BrandLayout from '../../layouts/BrandLayout.astro';
import Logo from '../../components/ui/Logo.astro';
import Button from '../../components/ui/Button.astro';
import { brandColorSwatches } from '../../data/brand-colors';
import { fontFamilies, taglines } from '@anzuk/brand';
import { withBase } from '../../lib/url';
---

<BrandLayout title="Overview" description="ANZUK Education brand overview and design system entry point.">
  <div class="max-w-3xl space-y-6">
    <p class="text-sm font-semibold uppercase tracking-wide text-anzuk-blue">Brand guide</p>
    <h1 class="!mt-0">ANZUK Education</h1>
    <p class="text-lg text-anzuk-content">
      Living style guide for the global marketing platform. Tokens and components here are the same
      building blocks used across regional marketing pages.
    </p>
  </div>

  <section class="mt-12 rounded-anzuk-card border border-anzuk-light-gray bg-white p-8">
    <h2 class="!mt-0 !text-2xl">Brand voice at a glance</h2>
    <blockquote class="mt-4 border-l-4 border-anzuk-blue pl-4">
      <p class="text-3xl font-semibold tracking-[-0.02em] text-anzuk-title">{taglines.primary}</p>
      <p class="mt-2 text-lg text-anzuk-content">{taglines.secondary}</p>
    </blockquote>
    <p class="mt-4 text-anzuk-content">
      Warm, confident, people-first — international expertise with local understanding.
    </p>
    <p class="mt-4">
      <a href={withBase('/brand/voice')}>Voice, personas & language guide</a>
    </p>
  </section>

  <section class="mt-12 grid gap-8 lg:grid-cols-2">
    <article class="rounded-anzuk-card border border-anzuk-light-gray bg-white p-8">
      <h2 class="!mt-0 !text-2xl">Logo</h2>
      <Logo class="mt-6 h-10 w-auto" />
      <p class="mt-4 text-anzuk-content">
        Wordmark with blue accent on the “i” and underline bar. See
        <a href={withBase('/brand/logos')}>logo usage</a>.
      </p>
    </article>

    <article class="rounded-anzuk-card border border-anzuk-light-gray bg-white p-8">
      <h2 class="!mt-0 !text-2xl">Typography</h2>
      <p class="mt-4 font-sans text-3xl font-semibold">Experience exceptional</p>
      <p class="mt-2 text-sm text-anzuk-content">
        Primary: {fontFamilies.primary} · Secondary: {fontFamilies.secondary}
      </p>
      <p class="mt-4">
        <a href={withBase('/brand/typography')}>View type scale</a>
      </p>
    </article>
  </section>

  <section class="mt-12">
    <h2 class="!text-3xl">Core palette</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        brandColorSwatches.slice(0, 4).map((swatch) => (
          <div class="rounded-anzuk-card overflow-hidden border border-anzuk-light-gray bg-white">
            <div class="h-16" style={`background-color: ${swatch.hex}`} />
            <div class="p-3 text-sm">
              <p class="font-semibold">{swatch.name}</p>
              <p class="font-mono text-xs">{swatch.hex}</p>
            </div>
          </div>
        ))
      }
    </div>
    <p class="mt-4">
      <a href={withBase('/brand/colours')}>View full colour system</a>
    </p>
  </section>

  <section class="mt-12 rounded-anzuk-card border border-anzuk-light-gray bg-white p-8">
    <h2 class="!mt-0 !text-2xl">Components</h2>
    <div class="mt-6 flex flex-wrap gap-4">
      <Button variant="primary">Schools enquiry</Button>
      <Button variant="secondary">Leadership search</Button>
      <Button variant="bordered">Search jobs</Button>
    </div>
    <p class="mt-4">
      <a href={withBase('/brand/components')}>View all components</a>
    </p>
  </section>

  <section class="mt-12">
    <h2 class="!text-2xl">Explore the guide</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <a href={withBase('/brand/voice')} class="rounded-anzuk-card border border-anzuk-light-gray bg-white p-6 no-underline hover:border-anzuk-blue">
        <h3 class="!mt-0 !text-lg font-semibold text-anzuk-title">Voice</h3>
        <p class="text-sm text-anzuk-content">Taglines, personas, tone, vocabulary</p>
      </a>
      <a href={withBase('/brand/colours')} class="rounded-anzuk-card border border-anzuk-light-gray bg-white p-6 no-underline hover:border-anzuk-blue">
        <h3 class="!mt-0 !text-lg font-semibold text-anzuk-title">Colours</h3>
        <p class="text-sm text-anzuk-content">Full palette with hex and Tailwind classes</p>
      </a>
      <a href={withBase('/brand/typography')} class="rounded-anzuk-card border border-anzuk-light-gray bg-white p-6 no-underline hover:border-anzuk-blue">
        <h3 class="!mt-0 !text-lg font-semibold text-anzuk-title">Typography</h3>
        <p class="text-sm text-anzuk-content">Poppins scale, body text, links</p>
      </a>
      <a href={withBase('/brand/logos')} class="rounded-anzuk-card border border-anzuk-light-gray bg-white p-6 no-underline hover:border-anzuk-blue">
        <h3 class="!mt-0 !text-lg font-semibold text-anzuk-title">Logos</h3>
        <p class="text-sm text-anzuk-content">Wordmark variants and clear space</p>
      </a>
      <a href={withBase('/brand/assets')} class="rounded-anzuk-card border border-anzuk-light-gray bg-white p-6 no-underline hover:border-anzuk-blue">
        <h3 class="!mt-0 !text-lg font-semibold text-anzuk-title">Assets</h3>
        <p class="text-sm text-anzuk-content">Illustrations, icons, UI decorations, photography</p>
      </a>
      <a href={withBase('/brand/components')} class="rounded-anzuk-card border border-anzuk-light-gray bg-white p-6 no-underline hover:border-anzuk-blue">
        <h3 class="!mt-0 !text-lg font-semibold text-anzuk-title">Components</h3>
        <p class="text-sm text-anzuk-content">Buttons, cards, section patterns</p>
      </a>
      <a href={withBase('/brand/demo')} class="rounded-anzuk-card border border-anzuk-light-gray bg-white p-6 no-underline hover:border-anzuk-blue">
        <h3 class="!mt-0 !text-lg font-semibold text-anzuk-title">Demo site</h3>
        <p class="text-sm text-anzuk-content">Modernised homepage, educators form, and jobs explorer concept</p>
      </a>
    </div>
  </section>
</BrandLayout>
