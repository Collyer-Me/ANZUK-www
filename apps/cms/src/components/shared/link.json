{
  "collectionName": "components_shared_links",
  "info": {
    "displayName": "Link",
    "description": "Internal page relation or external URL"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string"
    },
    "page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page"
    },
    "variant": {
      "type": "enumeration",
      "enum": ["primary", "secondary", "light", "outline"],
      "default": "primary"
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    }
  }
}
