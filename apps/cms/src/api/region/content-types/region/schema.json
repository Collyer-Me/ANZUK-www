{
  "kind": "collectionType",
  "collectionName": "site_regions",
  "info": {
    "singularName": "region",
    "pluralName": "regions",
    "displayName": "Region",
    "description": "Site boundary and regional configuration"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "code": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "hreflang": {
      "type": "string",
      "required": true
    },
    "isDefault": {
      "type": "boolean",
      "default": false
    },
    "isGlobalHub": {
      "type": "boolean",
      "default": false
    },
    "contactEmail": {
      "type": "email"
    },
    "contactPhone": {
      "type": "string"
    },
    "jobAdderBoardId": {
      "type": "string"
    },
    "geoSuggestEnabled": {
      "type": "boolean",
      "default": true
    },
    "cookiePolicyUrl": {
      "type": "string"
    },
    "header": {
      "type": "component",
      "repeatable": false,
      "component": "nav.menu"
    },
    "footer": {
      "type": "component",
      "repeatable": false,
      "component": "nav.footer"
    },
    "defaultSeo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
