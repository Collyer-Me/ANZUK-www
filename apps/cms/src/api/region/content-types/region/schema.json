{
  "kind": "collectionType",
  "collectionName": "regions",
  "info": {
    "singularName": "region",
    "pluralName": "regions",
    "displayName": "Region",
    "description": "Site boundary and regional configuration (au, uk, ca, nz, international). Do not rename collectionName — see docs/guides/strapi-region-model.md"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "code": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "hreflang": {
      "type": "string",
      "required": true
    },
    "isDefault": {
      "type": "boolean",
      "default": false
    },
    "isGlobalHub": {
      "type": "boolean",
      "default": false
    },
    "contactEmail": {
      "type": "email"
    },
    "contactPhone": {
      "type": "string"
    },
    "jobAdderBoardId": {
      "type": "string"
    },
    "geoSuggestEnabled": {
      "type": "boolean",
      "default": true
    },
    "cookiePolicyUrl": {
      "type": "string"
    }
  }
}
