{
  "kind": "collectionType",
  "collectionName": "localized_pages",
  "info": {
    "singularName": "localized-page",
    "pluralName": "localized-pages",
    "displayName": "Localized Page",
    "description": "Marketing page scoped by market. Slug is the URL path without market prefix (e.g. who-we-are/meet-the-team)."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "market": {
      "type": "enumeration",
      "enum": ["international", "au", "uk", "ca", "nz"],
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "pageTemplate": {
      "type": "enumeration",
      "enum": [
        "home-international",
        "home-regional",
        "service-educators",
        "service-schools",
        "service-leadership",
        "sector",
        "job-listing",
        "blog-listing",
        "about",
        "team-listing",
        "contact",
        "faq",
        "form-landing",
        "policy",
        "product",
        "process",
        "cross-market",
        "generic"
      ],
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "showInNav": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "navLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "navOrder": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "canonicalUrl": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "noIndex": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "jobBoardConfig": {
      "type": "component",
      "repeatable": false,
      "component": "shared.job-board-config",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "body": {
      "type": "dynamiczone",
      "components": [
        "blocks.hero",
        "blocks.feature-grid",
        "blocks.cta",
        "blocks.testimonial",
        "blocks.region-grid",
        "blocks.values-grid",
        "blocks.form-embed",
        "blocks.rich-text",
        "blocks.stats-row"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
