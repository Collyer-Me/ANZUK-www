{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Marketing page with region scope and page tree"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "region": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::region.region",
      "inversedBy": "pages",
      "required": true,
      "pluginOptions": {
        "i18n": { "localized": false }
      }
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::page.page",
      "inversedBy": "children",
      "pluginOptions": {
        "i18n": { "localized": false }
      }
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::page.page",
      "mappedBy": "parent"
    },
    "pageType": {
      "type": "enumeration",
      "enum": [
        "home-international",
        "home-regional",
        "service-educators",
        "service-schools",
        "service-leadership",
        "sector",
        "job-listing",
        "blog-listing",
        "about",
        "team-listing",
        "contact",
        "faq",
        "form-landing",
        "policy",
        "product",
        "process",
        "cross-market",
        "generic"
      ],
      "required": true,
      "pluginOptions": {
        "i18n": { "localized": false }
      }
    },
    "navLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "noIndex": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "jobBoardConfig": {
      "type": "component",
      "repeatable": false,
      "component": "shared.job-board-config",
      "pluginOptions": {
        "i18n": { "localized": false }
      }
    },
    "equivalents": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::page.page",
      "inversedBy": "equivalentOf",
      "pluginOptions": {
        "i18n": { "localized": false }
      }
    },
    "equivalentOf": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::page.page",
      "mappedBy": "equivalents"
    },
    "body": {
      "type": "dynamiczone",
      "components": [
        "blocks.hero",
        "blocks.feature-grid",
        "blocks.cta",
        "blocks.cta-band",
        "blocks.testimonial",
        "blocks.testimonials",
        "blocks.region-grid",
        "blocks.values-grid",
        "blocks.value-tabs",
        "blocks.form-embed",
        "blocks.rich-text",
        "blocks.stats-row",
        "blocks.stats-band",
        "blocks.persona-cards",
        "blocks.steps-row",
        "blocks.logo-marquee",
        "blocks.shared-section"
      ],
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    }
  }
}
