{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Settings",
    "description": "Global site configuration for the marketing platform"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "siteName": {
      "type": "string",
      "default": "ANZUK Education",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "defaultLocale": {
      "type": "enumeration",
      "enum": ["en-AU", "en-GB", "en-CA", "en-NZ"],
      "default": "en-AU",
      "required": true
    },
    "tagline": {
      "type": "string",
      "default": "International expertise in education. Local understanding.",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "organizationUrl": {
      "type": "string"
    },
    "contactEmail": {
      "type": "email"
    },
    "scootUrl": {
      "type": "string",
      "default": "https://scoot.education"
    },
    "executiveUrl": {
      "type": "string",
      "default": "https://www.anzukexecutive.com"
    },
    "geoSuggestEnabled": {
      "type": "boolean",
      "default": true
    },
    "affiliateBrands": {
      "type": "component",
      "repeatable": true,
      "component": "shared.affiliate-brand"
    },
    "marketNavigations": {
      "type": "component",
      "repeatable": true,
      "component": "shared.market-navigation",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
